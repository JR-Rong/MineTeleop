auth:
  drivers:
    - id: driver-console-001
      # Argon2id PHC verifier, produced by scripts/admin/add_driver.sh. Keep
      # the plaintext password outside this configuration tree.
      password_hash_file: secrets/driver-console-001.password.argon2id
      vehicles:
        - vehicle-001
  vehicles:
    - id: vehicle-001
      device_token_file: secrets/vehicle-001.token
