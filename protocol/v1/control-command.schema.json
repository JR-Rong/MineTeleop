{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mine-teleop:protocol:v1:control-command",
  "title": "Mine Teleop v1 control command",
  "description": "Draft structural wire contract for a v1 control_command. Authorization, freshness, replay prevention, and vehicle safety admission are deliberately outside this schema.",
  "$comment": "Unknown properties are intentionally accepted for additive v1 compatibility. This schema defines the portable JSON-number profile shared by C++ and JavaScript producers.",
  "x-protocol-status": "draft",
  "x-portable-json-integer-maximum": 9007199254740991,
  "type": "object",
  "required": [
    "type",
    "protocol_version",
    "vehicle_id",
    "driver_id",
    "session_id",
    "seq",
    "sent_at_utc_ms",
    "control_token",
    "gear",
    "steering",
    "throttle",
    "brake"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "control_command"
    },
    "protocol_version": {
      "type": "integer",
      "const": 1
    },
    "vehicle_id": {
      "type": "string",
      "minLength": 1
    },
    "driver_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sent_at_utc_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "control_token": {
      "type": "string",
      "minLength": 1
    },
    "gear": {
      "type": "string",
      "enum": [
        "P",
        "R",
        "N",
        "D"
      ]
    },
    "steering": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 1.0
    },
    "throttle": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "brake": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "estop": {
      "type": "boolean",
      "default": false,
      "description": "Optional in v1; an omitted value means false at the current C++ wire boundary."
    }
  },
  "additionalProperties": true
}
